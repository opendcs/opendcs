

select(where, limit, columns, collate) ::= <<
    select <columns>,
           app.loading_application_name se_loading_application_name,
           spec.name se_routingspec_name
      from schedule_entry se
    left outer join hdb_loading_application app on app.loading_application_id = se.loading_application_id
    left outer join routingspec spec on spec.id = se.routingspec_id
    <if(where)> <where> <endif>
    order by se.name <collate> asc
    <if(limit)> <limit> <endif>
>>

merge(dual, routingspec, loadingapp) ::= <<
    merge into schedule_entry se
    using (select :schedule_entry_id schedule_entry_id, :name name, :loadingappValue loadingappValue,
            :routingspecValue routingspecValue, :start_time start_time, :timezone timezone, :run_interval run_interval,
            :enabled enabled, :last_modified last_modified    
            <dual>) input
    on (se.schedule_entry_id = input.schedule_entry_id)
    when matched then
        update set name = input.name, loading_application_id = <loadingapp>, routingspec_id = <routingspec>,
            start_time = input.start_time, timezone = input.timezone, run_interval = input.run_interval,
            enabled = input.enabled, last_modified = input.last_modified
    when not matched then
        insert(schedule_entry_id, name, loading_application_id, routingspec_id, start_time, timezone,
               run_interval, enabled, last_modified)
        values(input.schedule_entry_id, input.name, <loadingapp>, <routingspec>, input.start_time, input.timezone,
               input.run_interval, input.enabled, input.last_modified)
>>


delete() ::= "delete from schedule_entry where schedule_entry_id = :schedule_entry_id"
