
select(where, limit, offset, prefix, collate, columns) ::= <<
    select <columns>, <prefix>.config::text as <prefix>_config
     from lrgs_data_interface <prefix>
     <if(where)>where <where> <endif>
    order by <prefix>.name <collate> asc
    <if(limit)>  <limit> <endif>
>>

merge(dual) ::= <<
    merge into lrgs_data_interface ldi
    using (select :id id, :name name, :type_name type_name, :config::jsonb config <dual>)  input
    on (ldi.id = input.id)
    when matched then
        update set name = input.name, type_name = input.type_name, config = input.config
    when not matched then
        insert(name, type_name, config)
        values(input.name, input.type_name, input.config)
>>


delete() ::= "delete from lrgs_data_interface where id = :id"

