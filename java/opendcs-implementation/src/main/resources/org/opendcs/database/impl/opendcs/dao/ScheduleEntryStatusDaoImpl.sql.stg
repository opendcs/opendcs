

select(where, limit, columns, prefix) ::= <<
    select <columns>
     from schedule_entry_status <prefix>
    <if(where)> <where> <endif>
    order by <prefix>.schedule_entry_status_id asc,
             <prefix>.schedule_entry_id asc,
             <prefix>.last_modified asc
    <limit>
>>


merge(dual) ::= <<
    merge into schedule_entry_status ses
    using (select :schedule_entry_status_id schedule_entry_status_id, :schedule_entry_id schedule_entry_id,
            :run_start_time run_start_time, :last_message_time last_message_time, :run_complete_time run_complete_time,
            :hostname hostname, :run_status run_status, :num_message num_message, :num_decode_errors num_decode_errors,
            :num_platforms num_platforms, :last_source last_source, :last_consumer last_consumer,
            :last_modified last_modified

     <dual>) input
    on (ses.schedule_entry_status_id = input.schedule_entry_status_id)
    when matched then
        update set ses.schedule_entry_id = input.schedule_entry_id, ses.run_start_time = input.run_start_time,
            ses.last_message_time = input.last_message_time, ses.run_complete_time = input.run_complete_time,
            ses.hostname = input.hostname, set.run_status = input.run_status, ses.num_message = input.num_messages,
            ses.num_decode_errors = input.num_decode_errors, ses.num_platforms = input.num_platforms,
            ses.last_source = input.last_source, ses.last_consumer = input.last_consumer,
            ses.last_modified = input.last_modified
    when not matched then
        insert(
            schedule_entry_status_id, schedule_entry_id, run_start_time, last_message_time, run_complete_time,
            hostname, run_status, num_message, num_decode_errors, num_platforms, last_source, last_consumer,
            last_modified)
        values(
            input.schedule_entry_status_id, input.schedule_entry_id, input.run_start_time, input.last_message_time,
            input.run_complete_time, input.hostname, input.run_status, input.num_message, input.num_decode_errors,
            input.num_platforms, input.last_source, input.last_consumer, input.last_modified)
>>

delete(where) ::= <<
    -- a bit simple, but there's a lot of options, let the usage point sort it out.
    delete from schedule_entry_status where <where>
>>
    
deletePlatformStatus() ::= <<
    delete from platform_status
     where last_schedule_entry_status_id = :schedule_entry_status_id
>>