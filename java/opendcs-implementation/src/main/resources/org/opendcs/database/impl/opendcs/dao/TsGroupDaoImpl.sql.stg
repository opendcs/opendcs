group TsGroupDaoImpl;

//! Two ways to say which groups a read applies to. Both produce a one column CTE named grp,
//! which is all the queries below care about, so one group, a page of groups and a whole
//! hierarchy each cost the same handful of statements.

filteredGroups(where, collate, limit) ::= <<
with grp as (
    select tg.group_id
      from tsdb_group tg
     <where>
     order by tg.group_name <collate> asc
     <limit>
)
>>

//! The groups at and below the one named by :group_id. UNION rather than UNION ALL, which
//! both collapses a group reachable more than once and stops the recursion when the data
//! contains a loop.
hierarchyGroups(recursive_cte) ::= <<
with <recursive_cte> grp(group_id) as (
    select tg.group_id
      from tsdb_group tg
     where tg.group_id = :group_id

    union

    select m.child_group_id
      from tsdb_group_member_group m
      join grp on grp.group_id = m.parent_group_id
)
>>

//! The groups at and above the one named by :group_id.
affectedGroups(recursive_cte) ::= <<
with <recursive_cte> grp(group_id) as (
    select tg.group_id
      from tsdb_group tg
     where tg.group_id = :group_id

    union

    select m.parent_group_id
      from tsdb_group_member_group m
      join grp on grp.group_id = m.child_group_id
)
>>

ids(groups) ::= <<
<groups>
select group_id from grp
 order by group_id
>>

headers(groups, collate, ref_columns) ::= <<
<groups>
select <ref_columns>
  from grp
  join tsdb_group tg on tg.group_id = grp.group_id
 order by tg.group_name <collate> asc
>>

idMembers(groups, table, column) ::= <<
<groups>
select m.group_id group_id, m.<column> member_id
  from <table> m
 where m.group_id in (select group_id from grp)
 order by m.group_id, m.<column>
>>

attributes(groups) ::= <<
<groups>
select m.group_id group_id, m.member_type member_type, m.member_value member_value
  from tsdb_group_member_other m
 where m.group_id in (select group_id from grp)
 order by m.group_id, m.member_type, m.member_value
>>

//! Sub-groups join back to tsdb_group because a link holds the whole reference: the
//! association table itself only knows the child's key.
links(groups, child_columns) ::= <<
<groups>
select m.parent_group_id group_id, <child_columns>, m.include_group include_group
  from tsdb_group_member_group m
  join tsdb_group child on child.group_id = m.child_group_id
 where m.parent_group_id in (select group_id from grp)
 order by m.parent_group_id, child.group_name
>>

tsMembers(collate, site_columns, site_name_columns) ::= <<
select mts.ts_id ts_id,
       case when tsi.id is null then 0 else 1 end ts_exists,
       tsi.id tsi_id, tsi.ts_version tsi_version, tsi.site_name tsi_site_name,
       tsi.unique_string tsi_unique_string, tsi.interval tsi_interval, tsi.duration tsi_duration,
       tsi.active_flag tsi_active_flag, tsi.storage_units tsi_storage_units,
       tsi.storage_table tsi_storage_table, tsi.storage_type tsi_storage_type,
       tsi.modify_time tsi_modify_time, tsi.description tsi_description,
       tsi.utc_offset tsi_utc_offset, tsi.allow_dst_offset_variation tsi_allow_dst_offset_variation,
       tsi.offset_error_action tsi_offset_error_action,

       dt.id dt_id, dt.standard dt_standard, dt.code dt_code, dt.display_name dt_display_name,

       <site_columns>,

       <site_name_columns>

  from tsdb_group_member_ts mts
  left outer join time_series_identifier tsi on tsi.id = mts.ts_id
  left outer join datatype dt on dt.id = tsi.datatype_id
  left outer join site s on s.id = tsi.site_id
  left outer join sitename sn on sn.siteid = tsi.site_id

 where mts.group_id = :group_id

 order by tsi.unique_string <collate> asc, sn.nametype
>>
