group NetworkListDaoImpl;

select(where_clause, medium_filter, collate, list_columns, entry_columns, entry_join, limit) ::= <<
with networklist_filtered(id, name, transportmediumtype, sitenametypepreference, lastmodifytime) as (
    select id, name, transportmediumtype, sitenametypepreference, lastmodifytime
      from networklist
    <if(where)><where><endif>
    <if(medium_filter>)
        <if(where)> and <else> where <endif>
        <medium_filter>
    <endif>
    order by name <collate> asc
    <if(limit)><limit><endif>
)

select 
    <list_columns>
    <if(entry_columns)>, <entry_columns><endif>
from networklist nl
<if(entry_join)><entry_join><endif>
order by nl.name <collate> asc, nle.transportid <collate> asc
>>


networkListMerge(dual) ::= <<
merge into networklist nl
using (select :id id, :name name, :transportmediumtype transportmediumtype, 
       :sitenametypepreference sitenametypepreference, :lastmodifytime lastmodifytime <dual>) input
on (nl.id = p.id)
when matched then
    update set name = input.name, transportmediumtype = input.transportmediumtype,
        sitenametypepreference = input.sitenametypepreference, lastmodifytime = input.lastmodifytime
when not matched then
    insert(id, name, transportmediumtype, sitenametypepreference, lastmodifytime)
    values(input.id, input.name, input.transportmediumtype, input.sitenametypepreference, input.lastmodifytime)
>>


deleteNetworkList() ::= "delete from networklist where id = :id"
deleteNetworkListEntry() ::= "delete from networklistentry where networklistid = :networklistid"
insertNetworkListEntry() ::= <<
insert into networklistentry(networklistid, transportid, platform_name, description)
values (:networklistid, :transportid, :platform_name, :description)

>>

